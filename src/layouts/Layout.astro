---
import { experimentDataAttributes, type Experiment, type Variant } from '../lib/experiments';

interface Props {
	/** The resolved experiment for the current page, or null/undefined for non-experiment pages. */
	experiment?: Experiment | null;
	/** The resolved variant for the current page, or null/undefined for non-experiment pages. */
	variant?: Variant | null;
}

const { experiment, variant } = Astro.props;
const currentYear = new Date().getFullYear();

// Build data attributes for client-side conversion tracking. Returns an empty
// object on non-experiment pages so the spread below is a no-op.
const experimentAttributes = experimentDataAttributes(experiment, variant);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Storyblok & Astro</title>
		<link
			rel="stylesheet"
			href="https://a.storyblok.com/f/212319/x/e6ccda03b8/blueprint-blank.css"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body {...experimentAttributes}>
		<slot />
		<footer>All rights reserved © {currentYear}</footer>
	</body>
</html>
