---
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import Layout from '../layouts/Layout.astro';
import { countOnce, getExperimentsClient } from '../lib/experiments';

const originalSlug = Astro.params.slug || 'home';
// Storyblok appends `_storyblok` when rendering inside the Visual Editor.
const isVisualEditor = Astro.url.searchParams.has('_storyblok');

const storyblokApi = useStoryblokApi();

let slug = originalSlug;

if (!isVisualEditor) {
	const client = await getExperimentsClient(storyblokApi);
	// `exposure: false` hands back the event instead of delivering it, so the
	// visitor's cookies get a say first. The assignment is unaffected: the visitor
	// still sees the same variant on every view, only the impression is counted
	// once, which is what makes it comparable to the once-counted conversion.
	const resolved = client.resolveExperiment({
		slug: originalSlug,
		visitorId: Astro.locals.visitorId,
		exposure: false,
	});
	slug = resolved.slug;

	// Awaiting the send, rather than `flush()`: the instance is shared, so
	// `flush()` would also wait on other requests' deliveries.
	if (resolved.exposure && countOnce(Astro.cookies, 'exp', resolved.exposure.experiment.id)) {
		await client.send(resolved.exposure);
	}

	// A control assignment also yields a `variant` (with `is_control: true`),
	// leaving the slug unchanged. The header appearing for control visitors
	// is correct and intended.
	if (resolved.variant) {
		Astro.response.headers.set(
			'x-storyblok-variant',
			`${resolved.variant.name} (${resolved.variant.public_id})`,
		);
	}
}

const { data } = await storyblokApi.get(`cdn/stories/${slug}`, {
	version: 'draft',
});

const story = data.story;
---

<Layout>
	<StoryblokComponent blok={story.content} />
</Layout>

<script>
	// Send the goal only. The server derives the experiment, the variant, and the
	// visitor, so the payload is tiny and a visitor cannot forge which variant
	// converted. `sendBeacon` survives the unload a link or a form submit causes.
	document.querySelectorAll<HTMLElement>('[data-goal]').forEach((element) =>
		element.addEventListener('click', () =>
			navigator.sendBeacon(
				'/api/experiments',
				JSON.stringify({ goal: element.dataset.goal }),
			),
		),
	);
</script>